# Copia este archivo como .env y completa los valores de tu proyecto Supabase.
# El archivo .env no se sube al repositorio.
# SUPABASE_URL: Project URL (Settings > API), por ejemplo https://<project-ref>.supabase.co
# SUPABASE_KEY: solo la llave publishable (sb_publishable_...) o la anon. Nunca la secret ni la service_role.
# PORT: opcional; si se deja vacío se usa 3000.
SUPABASE_URL=
SUPABASE_KEY=
PORT=
# TEST_EMAIL / TEST_PASSWORD: usuario de prueba para las pruebas automáticas (Día 5 en adelante).
TEST_EMAIL=
TEST_PASSWORD=
